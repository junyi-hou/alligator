{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.3"}
        org.clojure/core.async {:mvn/version "1.6.681"}
        org.clojure/tools.cli {:mvn/version "1.3.250"}
        com.taoensso/timbre {:mvn/version "6.8.0"}
        com.github.clojure-lsp/jsonrpc4clj {:mvn/version "1.0.2"}
        io.github.tonsky/toml-clj {:mvn/version "0.1.0"}}

 :aliases
 {:run {:main-opts ["-m" "alligator.core"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}}
  :build {:extra-paths ["resources"]
          :deps {io.github.clojure/tools.build
                 {:git/tag "v0.9.2" :git/sha "fe6b140"}}
          :ns-default build}}}
