{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.3"}
        clojupyter/clojupyter {:mvn/version "0.4.319"}
        org.clojure/core.async {:mvn/version "1.6.681"}
        com.github.clojure-lsp/jsonrpc4clj {:mvn/version "1.0.2"}}

 :aliases
 {;; uncomment the next line to enable `run` alias
  ;; :run {:main-opts ["-m" "[NAMESPACE].core"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}}
  :build {:extra-paths ["resources"]
          :deps {io.github.clojure/tools.build
                 {:git/tag "v0.9.2" :git/sha "fe6b140"}}
          :ns-default build}}}
